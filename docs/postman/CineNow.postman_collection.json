			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "name", "value": "Demo User" },
								{ "key": "email", "value": "demo@cinenow.test" },
								{ "key": "password", "value": "Password@123" },
								{ "key": "password_confirmation", "value": "Password@123" },
								{ "key": "mobile_no", "value": "9999999999" }
							]
						},
						"url": { "raw": "{{base_url}}/api/register", "host": ["{{base_url}}"], "path": ["api", "register"] }
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"try {",
									"  var res = pm.response.json();",
									"  var token = res.token || (res.data && res.data.token) || (res.data && res.data.access_token) || res.access_token;",
									"  if (token) { pm.collectionVariables.set('token', token); }",
									"} catch (e) {}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "email", "value": "demo@cinenow.test" },
								{ "key": "password", "value": "Password@123" }
							]
